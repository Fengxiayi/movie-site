# =========================================================
#  运行环境配置文件
#  安装位置：/opt/movie-site/deploy/movie-site.env
#  权限：chown root:cine && chmod 640
# =========================================================

# Node 服务监听端口（仅本机，由 Nginx 反代）
PORT=3000
HOST=127.0.0.1

# 数据目录（SQLite 数据库文件所在位置）
DATA_DIR=/opt/movie-site/data

# 会话有效期（天）
SESSION_DAYS=30

# 启用 HTTPS 后改为 1，让会话 Cookie 只通过 HTTPS 传输
COOKIE_SECURE=1

# 首次启动自动创建的管理员账号，部署完成后请务必修改
ADMIN_USER=admin
ADMIN_PASS=ChangeMe_2026

# 站点显示名称 / 公告（可选）
SITE_NAME=光影录
SITE_NOTICE=
